// ---------------------------------------------------------------------------
// Minimal STM32G431 (Nucleo-G431RB) platform for Renode.
//
// Renode ships NO STM32G4 platform (renode/renode#525 is still open), and the
// G0/L0 CPU repls don't model an RCC at all. So this is hand-rolled and
// deliberately minimal: just enough to boot the ELF, get RccExt::freeze() past
// the clock-ready polls, and toggle PA5 (the Nucleo user LED).
//
// Model class names were copied verbatim from the upstream Renode platforms
// (platforms/cpus/stm32f4.repl and stm32l071.repl). If your Renode version
// renames a class, `grep` those files in your install's platforms/ directory.
// ---------------------------------------------------------------------------

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000       // HSI16 default; the LED test doesn't rely on it
    IRQ -> cpu@0

// --- Memory map (STM32G431RB) ----------------------------------------------
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000                    // 128 KB

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000                     // 32 KB

ccmram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x8000                     // CCM SRAM (G4 maps it here); harmless to include

// --- Clock shim (THE important bit) ----------------------------------------
// The whole hang is the HAL busy-polling RCC ready bits. There is no accurate
// G4 RCC model in Renode, and the F4 RCC has HSIRDY at a different bit than G4,
// so instead of Miscellaneous.STM32F4_RCC we drop in a tiny Python peripheral
// that mirrors writes and forces the ready bits so freeze() completes.
rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    filename: "rcc_shim.py"

// --- GPIO (AHB2 @ 0x48000000 on G4) ----------------------------------------
gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0xABFFFFFF       // approximate G4 reset (PA13/14/15 = SWD AF); test reconfigures PA5 anyway
    numberOfAFs: 16

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    numberOfAFs: 16

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    numberOfAFs: 16

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>
    numberOfAFs: 16

// --- A couple of general-purpose timers, in case you exercise them later ----
timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 16000000
    -> nvic@28

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    frequency: 16000000
    -> nvic@29

// --- Motor PWM timers (M1) --------------------------------------------------
// TIM1/TIM8 are STM32G4 *advanced-control* timers (complementary outputs,
// BDTR deadtime/break register, RCR repetition counter) - Renode's generic
// Timers.STM32_Timer model (same class as timer2/3 above) is a *basic* timer
// model. PSC/ARR/CNT/CCRx should read/write fine; BDTR is advanced-timer-only
// and this model likely doesn't back it, so a write (e.g. our MOE/deadtime
// setup in motor.rs) probably won't fault but also won't be read back
// correctly if you write a test that checks it. Our firmware doesn't read
// BDTR back, so this is a known gap rather than a blocker for M1.
// IRQ lines intentionally left unwired - nothing in the firmware enables a
// TIM1/TIM8 interrupt yet (M1 uses polling only); wire -> nvic@N when M2's
// commutation ISR actually needs one.
tim1: Timers.STM32_Timer @ sysbus 0x40012c00
    frequency: 16000000

tim8: Timers.STM32_Timer @ sysbus 0x40013400
    frequency: 16000000

// --- Command/telemetry UART (M1) --------------------------------------------
// Class name/properties unverified in this sandbox (no Renode install here
// to check against) - UART.STM32_UART is what most official Renode STM32
// platform files use, but if this errors, grep your local Renode's
// platforms/peripherals/UARTs/ for the actual class and adjust.
usart1: UART.STM32_UART @ sysbus 0x40013800
    frequency: 16000000

// --- Motor phase/current/voltage sensing ADCs (M1) --------------------------
// Renode ships no STM32G4 ADC model at all (same gap the RCC shim below
// exists for) - adc_shim.py is a register-level shim, not a real ADC; see its
// header comment for exactly what it fakes and why. ADC12_COMMON isn't on
// the code path the shim targets, so it's left unmodeled here.
adc1: Python.PythonPeripheral @ sysbus 0x50000000
    size: 0x100
    initable: true
    filename: "adc_shim.py"

adc2: Python.PythonPeripheral @ sysbus 0x50000100
    size: 0x100
    initable: true
    filename: "adc_shim.py"

// NOTE: PWR (0x40007000) and FLASH ACR (0x40022000) are NOT modeled here.
// At the HAL's default HSI16 config that's fine (0 flash wait-states, VOS ready
// at reset). If you later boost SYSCLK via the PLL, you'll need to model/shim
// FLASH_ACR latency read-back and the PLL lock, or freeze() will hang again.
